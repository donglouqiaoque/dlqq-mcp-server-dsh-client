{
  "name": "dlqq-mcp-client",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：为 MCP 客户端注入会话 ID（params._meta），让同一个 MCP 服务进程按对话隔离工作区，替代官方 dsh-mcp-client 的单实例行为。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "dist",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "esbuild lib/official/index.ts --bundle --format=esm --platform=node --target=node20 --external:@deepseek-ai/* --external:@modelcontextprotocol/* --outfile=dist/plugin.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/client": "2.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-mcp-resources": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-resources": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/donglouqiaoque/dlqq-mcp-server-dsh-client.git"
  },
  "license": "MIT"
}
